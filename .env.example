# Optional: use the browser setup instead. Never commit real credentials.
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Public HTTPS tunnel forwarding to localhost:3000, needed only for real calls.
PUBLIC_URL=
PORT=3000
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-live-transcribe
ELEVENLABS_MODEL=eleven_flash_v2_5
# Optional: absolute path or a path relative to your working directory.
# Defaults to recordings/ inside this repository.
RECORDINGS_DIR=
